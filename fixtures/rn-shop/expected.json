{
  "$comment": "Ground truth for Pragu Bench. Each entry names a rule and an element's testID (exposed on Android as the view's resource id). 'barriers' must be reported; 'correctTwins' must not be. Rules not implemented yet are kept and skipped until they exist.",
  "fixture": "rn-shop",
  "appId": "dev.pragu.fixtures.rnshop",
  "apk": "android/app/build/outputs/apk/release/app-release.apk",
  "screens": [
    {
      "id": "cart",
      "name": "Cart",
      "url": "rnshop://cart",
      "marker": "screen-cart",
      "barriers": [
        { "rule": "focus/unreachable", "testID": "seed-hidden-button", "note": "importantForAccessibility=\"no-hide-descendants\": works by touch only" },
        { "rule": "name/interactive-missing", "testID": "seed-unlabeled-remove" },
        { "rule": "contrast/text", "testID": "seed-low-contrast" },
        { "rule": "target/size", "testID": "seed-tiny-dismiss" },
        { "rule": "state/not-exposed", "testID": "seed-stateless-checkbox", "note": "accessibilityRole=\"checkbox\" without a checked state: TalkBack says \"Checkbox\" but never \"checked\"" }
      ],
      "correctTwins": [
        { "rule": "focus/unreachable", "testID": "twin-hidden-inner", "note": "hidden inside a row that is one accessible control offering the same action" },
        { "rule": "focus/unreachable", "testID": "twin-reachable-row" },
        { "rule": "name/interactive-missing", "testID": "twin-labeled-remove" },
        { "rule": "name/interactive-missing", "testID": "twin-stateful-checkbox" },
        { "rule": "name/interactive-missing", "testID": "seed-stateless-checkbox", "note": "named by its text; only its state is missing" },
        { "rule": "contrast/text", "testID": "twin-good-contrast" },
        { "rule": "target/size", "testID": "twin-close-cart" },
        { "rule": "state/not-exposed", "testID": "twin-stateful-checkbox", "note": "aria-checked exposes the state" }
      ]
    },
    {
      "id": "cart-dialog",
      "name": "Cart, remove dialog",
      "url": "rnshop://cart?dialog=remove",
      "marker": "screen-cart-dialog",
      "barriers": [
        { "rule": "name/interactive-missing", "testID": "seed-dialog-unlabeled-close" },
        { "rule": "contrast/text", "testID": "seed-dialog-low-contrast", "note": "#AAAAAA on white is 2.3:1" }
      ],
      "correctTwins": [
        { "rule": "name/interactive-missing", "testID": "twin-dialog-keep" },
        { "rule": "name/interactive-missing", "testID": "seed-unlabeled-remove", "note": "behind the open dialog: nobody can act on it until the dialog closes" },
        { "rule": "contrast/text", "testID": "screen-cart-dialog" },
        { "rule": "contrast/text", "testID": "seed-low-contrast", "note": "behind the dialog's scrim" },
        { "rule": "target/size", "testID": "seed-tiny-dismiss", "note": "behind the open dialog" },
        { "rule": "target/size", "testID": "twin-dialog-remove" }
      ]
    },
    {
      "id": "product",
      "name": "Product",
      "url": "rnshop://product",
      "marker": "screen-product",
      "barriers": [
        { "rule": "name/image-missing", "testID": "seed-unnamed-image", "note": "accessible image with no label: TalkBack says only \"Image\"" },
        { "rule": "name/interactive-missing", "testID": "seed-unlabeled-favorite" },
        { "rule": "name/interactive-missing", "testID": "seed-unlabeled-share" },
        { "rule": "contrast/text", "testID": "seed-low-contrast-badge" },
        { "rule": "contrast/text", "testID": "seed-low-contrast-sku" },
        { "rule": "target/size", "testID": "seed-tiny-minus" },
        { "rule": "target/size", "testID": "seed-tiny-plus" }
      ],
      "correctTwins": [
        { "rule": "name/image-missing", "testID": "twin-named-image" },
        { "rule": "name/image-missing", "testID": "twin-decorative-image", "note": "not a focus stop, so TalkBack skips it, as it should a decorative image" },
        { "rule": "name/interactive-missing", "testID": "twin-labeled-back" },
        { "rule": "name/interactive-missing", "testID": "twin-text-button" },
        { "rule": "name/interactive-missing", "testID": "twin-isolated-info" },
        { "rule": "contrast/text", "testID": "screen-product", "note": "26 dp large text at 3.4:1 passes (needs 3:1)" },
        { "rule": "contrast/text", "testID": "twin-price" },
        { "rule": "contrast/text", "testID": "twin-text-on-photo", "note": "white on dark stripes; a busy background must not produce a guess" },
        { "rule": "target/size", "testID": "twin-isolated-info", "note": "20 dp but isolated: WCAG spacing exception" },
        { "rule": "target/size", "testID": "twin-hitslop-remove", "note": "16 dp view, but hitSlop makes the touch area 48 dp; invisible in the accessibility tree" },
        { "rule": "target/size", "testID": "twin-text-button" }
      ]
    },
    {
      "id": "form",
      "name": "Delivery form",
      "url": "rnshop://form",
      "marker": "screen-form",
      "barriers": [
        { "rule": "name/interactive-missing", "testID": "seed-unlabeled-checkbox" },
        { "rule": "contrast/text", "testID": "seed-placeholder-only", "note": "placeholder #B0B0B0 on white is 2.1:1" },
        { "rule": "input/missing-label", "testID": "seed-unlabeled-input", "note": "the \"Promo code\" text above is not connected to it; TalkBack says only \"Edit box\"" },
        { "rule": "input/placeholder-label", "testID": "seed-placeholder-only", "note": "placeholder only: it disappears from view as soon as someone types" },
        { "rule": "state/not-exposed", "testID": "seed-unlabeled-checkbox", "note": "no role either: nothing in the tree says it is a checkbox, so a scan cannot tell it from a button. Seeing it needs a tap (crawler, M3)" }
      ],
      "correctTwins": [
        { "rule": "name/interactive-missing", "testID": "twin-labeled-switch" },
        { "rule": "name/interactive-missing", "testID": "twin-continue" },
        { "rule": "name/interactive-missing", "testID": "twin-disabled-labeled" },
        { "rule": "contrast/text", "testID": "twin-labelled-name", "note": "placeholder #6B6963 on white is 5.5:1" },
        { "rule": "contrast/text", "testID": "twin-disabled-text", "note": "inactive components have no contrast requirement (WCAG 1.4.3)" },
        { "rule": "input/missing-label", "testID": "twin-labelled-name" },
        { "rule": "input/missing-label", "testID": "twin-labelledby-input", "note": "aria-labelledby connects the visible label" },
        { "rule": "input/missing-label", "testID": "seed-placeholder-only", "note": "its placeholder is the hint, which TalkBack keeps reading after typing; what it lacks is a label that stays in view (input/placeholder-label)" },
        { "rule": "input/placeholder-label", "testID": "twin-labelled-name" },
        { "rule": "state/not-exposed", "testID": "twin-labeled-switch" }
      ]
    }
  ]
}
