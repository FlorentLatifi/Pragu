{
  "name": "pragu-monorepo",
  "private": true,
  "description": "Pragu finds the accessibility barriers in your mobile app on every pull request.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "pragu": "node packages/cli/dist/bin.js",
    "agent:build": "node scripts/build-agent.mjs",
    "fixture:build": "node scripts/build-fixture.mjs",
    "fixture:scan": "node packages/cli/dist/bin.js scan --install fixtures/rn-shop/android/app/build/outputs/apk/release/app-release.apk --app dev.pragu.fixtures.rnshop --screen-name Cart --out reports/rn-shop",
    "fixture:verify": "node scripts/verify-fixture.mjs reports/rn-shop/pragu-result.json fixtures/rn-shop/expected.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
