{
  "name": "pragu",
  "version": "0.1.0",
  "description": "Find the accessibility barriers in your mobile app before your users hit them.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlorentLatifi/Pragu.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/FlorentLatifi/Pragu#readme",
  "type": "module",
  "bin": {
    "pragu": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "agent"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@pragu/core": "workspace:*",
    "@pragu/report": "workspace:*",
    "pngjs": "7.0.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
