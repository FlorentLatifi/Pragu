{
  "name": "@pragu/report",
  "version": "0.0.0",
  "description": "Renders a Pragu scan result as one self-contained, offline HTML report.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlorentLatifi/Pragu.git",
    "directory": "packages/report"
  },
  "homepage": "https://github.com/FlorentLatifi/Pragu#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@pragu/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
