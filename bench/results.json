{
  "benchVersion": 1,
  "fixtures": [
    "android-compose",
    "rn-shop"
  ],
  "screens": 6,
  "rules": [
    {
      "rule": "name/interactive-missing",
      "severity": "error",
      "tp": 8,
      "fp": 0,
      "fn": 0,
      "tn": 16,
      "precision": 1,
      "recall": 1,
      "f1": 1,
      "mcc": 1
    },
    {
      "rule": "name/image-missing",
      "severity": "error",
      "tp": 1,
      "fp": 0,
      "fn": 0,
      "tn": 2,
      "precision": 1,
      "recall": 1,
      "f1": 1,
      "mcc": 1
    },
    {
      "rule": "input/missing-label",
      "severity": "error",
      "tp": 2,
      "fp": 0,
      "fn": 0,
      "tn": 4,
      "precision": 1,
      "recall": 1,
      "f1": 1,
      "mcc": 1
    },
    {
      "rule": "state/not-exposed",
      "severity": "error",
      "tp": 2,
      "fp": 0,
      "fn": 2,
      "tn": 5,
      "precision": 1,
      "recall": 0.5,
      "f1": 0.6666,
      "mcc": 0.5976
    },
    {
      "rule": "contrast/text",
      "severity": "error",
      "tp": 6,
      "fp": 0,
      "fn": 0,
      "tn": 11,
      "precision": 1,
      "recall": 1,
      "f1": 1,
      "mcc": 1
    },
    {
      "rule": "target/size",
      "severity": "warning",
      "tp": 3,
      "fp": 1,
      "fn": 3,
      "tn": 11,
      "precision": 0.75,
      "recall": 0.5,
      "f1": 0.6,
      "mcc": 0.4724
    }
  ],
  "falsePositives": [
    {
      "fixture": "rn-shop",
      "screen": "product",
      "rule": "target/size",
      "element": "twin-hitslop-remove",
      "message": "This target is 16×16 dp and another target is 2.3 dp away. It needs to be at least 24×24 dp, or have that much space around it.",
      "note": "16 dp view, but hitSlop makes the touch area 48 dp; invisible in the accessibility tree"
    }
  ],
  "falseNegatives": [
    {
      "fixture": "android-compose",
      "screen": "checkout",
      "rule": "state/not-exposed",
      "element": "seed-custom-checkbox",
      "note": "no role either: nothing in the tree says it is a checkbox, so a scan cannot tell it from a button. Seeing it needs a tap (crawler, M3)"
    },
    {
      "fixture": "android-compose",
      "screen": "settings",
      "rule": "target/size",
      "element": "seed-crowded-star-2",
      "note": "16 dp stars that touch: a touch inside a neighbour goes to the neighbour, so this star takes touches over 16 dp only. Compose reports touch areas that meet, which Pragu cannot split"
    },
    {
      "fixture": "android-compose",
      "screen": "settings",
      "rule": "target/size",
      "element": "seed-crowded-star-3",
      "note": "as star 2"
    },
    {
      "fixture": "android-compose",
      "screen": "settings",
      "rule": "target/size",
      "element": "seed-crowded-star-4",
      "note": "as star 2"
    },
    {
      "fixture": "rn-shop",
      "screen": "form",
      "rule": "state/not-exposed",
      "element": "seed-unlabeled-checkbox",
      "note": "no role either: nothing in the tree says it is a checkbox, so a scan cannot tell it from a button. Seeing it needs a tap (crawler, M3)"
    }
  ],
  "awaiting": [
    {
      "rule": "input/placeholder-label",
      "barriers": 2,
      "correctTwins": 2
    }
  ]
}
